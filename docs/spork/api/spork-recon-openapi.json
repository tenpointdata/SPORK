    "/api/spork/v1/{tenant}/search" : {
      "post" : {
        "tags" : [ "Recon" ],
        "summary" : "Structured search: a page of up to 500 and a capped count",
        "description" : "Recon's structured search over every partition: the filters are ANDed, the page is up to 500 records (50 by default) in posted_desc, posted_asc or views_desc order. Served on direct cursors over the (facet, tsPosted, views) composites, the smallest filter driving; partial is true when a read cap stopped the page itself. The total is an ESTIMATE by default: the count reads a bounded number of index entries (so the request stays inside its latency budget) and totalExact says whether it reached the end. When totalExact is false, total is a lower bound (show it as \"N+\") and totalEstimate, when present, the count scaled from the driving filter's size (show it as \"about N\"); totalEstimate is left out when a posted window makes that scaling unreliable. exactTotal: true asks for the exact count up to 10,000 (totalCapped when more match), at the cost of reading up to every match. Records the person may not see are neither returned nor counted. phone, email, business and q (substring and full text) are refused with filterUnsupported for now. A title in the projection is read from the record's text partition through its textHash, and needs a grant on it.\n\nPurposes allowed: victim_identification, investigative_lead, network_disruption. Audit: one 'records.search' entry on the chain, committed before the response is released.",
        "operationId" : "searchRecords",
        "parameters" : [ {
          "name" : "tenant",
          "in" : "path",
          "description" : "The tenant, one of the installation's configured tenants",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "X-Spork-Context",
          "in" : "header",
          "description" : "base64url of the JSON Operating Context {caseRef?, purpose} (component SporkContext). Never identity, role or markings.",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "description" : "The request",
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SearchRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Released, and recorded on the audit chain",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SearchAnswer"
                }
              }
            }
          },
          "400" : {
            "description" : "The body is invalid: idsRequired, tooManyIds, projectionInvalid, searchInvalid, filterUnsupported",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SporkError"
                }
              }
            }
          },
          "401" : {
            "description" : "No credential, or one Entry rejects",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SporkError"
                }
