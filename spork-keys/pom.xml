<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.arcadedb</groupId>
        <artifactId>arcadedb-parent</artifactId>
        <version>26.11.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>arcadedb-spork-keys</artifactId>
    <name>SPORK canonical keys and schema</name>
    <description>SPORK canonical identifier keys (docs/spork/01-architecture.md 2.3), byte for byte with Recon's normalizations
        (golden vectors written from Recon's TypeScript), and the schema v1 installer for the identity, rec_p, txt_p, media_p
        and recdir databases. Pure engine library: no server dependency, so ingest, the offline build and the plugin share it.</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- The engine only: com.arcadedb.similarity.Stylometry (the Recon style24 port) and the Database/Schema API the
             installer drives. Never the server: the offline GraphBatch build embeds this module without one. -->
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-engine</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-engine</artifactId>
            <version>${project.parent.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj-core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
