<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.arcadedb</groupId>
        <artifactId>arcadedb-parent</artifactId>
        <version>26.11.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!--
        SPORK System 1 encoder sidecar (WS13, docs/spork/01-architecture.md 4c.4): a separate process per node, in the
        `encode` cgroup, that turns text (and later images) into the vectors and codes the LSM_IVF_VECTOR spaces store.
        It never runs inside the ArcadeDB JVM: ONNX Runtime and the tokenizer are native libraries, and keeping them out
        of the database process keeps their memory and their crashes out of it too. arcadedb-engine is a dependency only
        for its JSON classes and VectorUtils; nothing here opens a database.

        Models are not in the repository. scripts/export_gte.py fetches the pinned Hugging Face revision, exports and
        quantizes it into models/ (git-ignored); see docs/spork/workstreams/ws13-encoder.md.
    -->
    <artifactId>spork-encoder</artifactId>
    <name>SPORK encoder sidecar</name>
    <description>CPU-only ONNX Runtime encoder process for the SPORK System 1 multimodal index (WS13)</description>
    <packaging>jar</packaging>

    <properties>
        <onnxruntime.version>1.31.0</onnxruntime.version>
        <djl-tokenizers.version>0.38.0</djl-tokenizers.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spork.encoder.models>${project.basedir}/models</spork.encoder.models>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>runtime-classpath</id>
                        <phase>package</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/classpath.txt</outputFile>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-engine</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- MIT. The CPU build: bundles the native library for linux-x64, linux-aarch64, osx-arm64 and win-x64. -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>${onnxruntime.version}</version>
        </dependency>
        <!-- Apache-2.0. Hugging Face tokenizers through JNI, natives bundled in the jar; run with ai.djl.offline=true so it
             never fetches a native library at runtime (EncoderMain sets it). -->
        <dependency>
            <groupId>ai.djl.huggingface</groupId>
            <artifactId>tokenizers</artifactId>
            <version>${djl-tokenizers.version}</version>
        </dependency>
        <!-- The process is runnable on its own: route DJL's SLF4J logging into java.util.logging like the rest of it -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
