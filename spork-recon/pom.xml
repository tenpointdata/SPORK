<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.arcadedb</groupId>
        <artifactId>arcadedb-parent</artifactId>
        <version>26.11.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>arcadedb-spork-recon</artifactId>
    <packaging>jar</packaging>
    <name>ArcadeDB SPORK Recon plugin</name>
    <description>The spork-recon ServerPlugin: Recon's API under /api/spork/v1/{tenant}/ (docs/spork/01-architecture.md 7)</description>

    <properties>
        <!-- Same version the server module validates its own specification with -->
        <swagger-parser.version>2.1.48</swagger-parser.version>
    </properties>

    <dependencies>
        <!-- Provided, like the wire-protocol modules: the server is the assembly point -->
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-server</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- SPORK keys (record_id, upstream RID) and the schema v1 installer. Its engine dependency is the server's -->
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-spork-keys</artifactId>
            <version>${project.parent.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.arcadedb</groupId>
                    <artifactId>arcadedb-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-server</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>io.swagger.parser.v3</groupId>
            <artifactId>swagger-parser</artifactId>
            <version>${swagger-parser.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
